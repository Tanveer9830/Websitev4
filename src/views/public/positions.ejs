<%- include('../partials/head', { title, active: 'positions' }) %>

<div class="section-head">
  <h2 class="section-title">Available staff positions</h2>
  <span class="muted small"><%= total %> open position<%= total === 1 ? '' : 's' %></span>
</div>

<% if (positions.length === 0) { %>
  <div class="empty">
    <div class="icon">☁️</div>
    <h3>Nothing open at the moment</h3>
    <p>We post new positions regularly — check back soon.</p>
  </div>
<% } else { %>
  <div class="grid grid-2">
    <% for (const p of positions) { %>
      <div class="card lift">
        <div class="flex-between mb0">
          <span class="badge badge-open">Open</span>
          <span class="meta"><%= p.department %> · posted <%= new Date(p.created_at).toLocaleDateString() %></span>
        </div>
        <h3 style="margin-top:12px"><%= p.title %></h3>
        <p class="muted small"><%= p.summary %></p>
        <div class="row-actions mt">
          <a class="btn btn-primary btn-sm" href="/positions/<%= p.id %>">View details &amp; apply</a>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/pagination', { total, perPage, page, reqUrl: reqUrl }) %>

<%- include('../partials/footer') %>
