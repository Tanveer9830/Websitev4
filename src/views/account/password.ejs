<%- include('../partials/head', { title, active: 'account' }) %>
<%- include('../partials/flash') %>

<div class="auth-wrap">
  <div class="card auth-card">
    <h1>Change password</h1>
    <p class="sub"><%= forced ? 'You are required to set a new password before continuing.' : 'Choose a strong new password for your account.' %></p>
    <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
    <% if (success) { %><div class="flash flash-success"><%= success %></div><% } %>
    <form method="post" action="/account/password" class="stack" data-validate="1" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="current">Current password</label>
        <input type="password" id="current" name="current" required autocomplete="current-password">
      </div>
      <div class="field">
        <label for="next">New password</label>
        <input type="password" id="next" name="next" required minlength="10" maxlength="200" autocomplete="new-password">
        <div class="hint">At least 10 characters with letters and numbers.</div>
        <div class="pw-strength" id="pwStrength" aria-live="polite"></div>
      </div>
      <div class="field">
        <label for="next2">Confirm new password</label>
        <input type="password" id="next2" name="next2" required minlength="10" maxlength="200" autocomplete="new-password">
      </div>
      <button class="btn btn-primary" type="submit">
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Update password</span>
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
