<%- include('../partials/head', { title, active: 'account' }) %>
<%- include('../partials/flash') %>

<div class="dash-head">
  <div>
    <h1>My applications</h1>
    <p class="muted small mb0">Track every application, status change and message from staff.</p>
  </div>
  <a class="btn btn-primary btn-sm" href="/positions">Apply for a position</a>
</div>

<% if (apps.length === 0) { %>
  <div class="empty">
    <div class="icon">📭</div>
    <h3>You haven't applied yet</h3>
    <p>Browse the open positions and send in your first application.</p>
    <a class="btn btn-primary" href="/positions">See open positions</a>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th>Reference</th><th>Position</th><th>Status</th><th>Submitted</th><th>Messages</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% for (const a of apps) { %>
          <tr>
            <td><span class="ref"><%= a.reference %></span></td>
            <td><%= a.position_title %></td>
            <td><span class="badge badge-<%= a.status %>"><%= statusLabels[a.status] || a.status %></span></td>
            <td class="muted small"><%= new Date(a.created_at).toLocaleDateString() %></td>
            <td>
              <% if (a.messages.length) { %>
                <span class="flex" style="gap:6px"><span class="badge badge-reviewing"><%= a.messages.length %></span><span class="faint small">msg</span></span>
              <% } else { %>
                <span class="faint small">—</span>
              <% } %>
            </td>
            <td><a class="btn btn-ghost btn-sm" href="/account/applications/<%= a.id %>">View</a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="panel mt">
  <h2>Account</h2>
  <div class="flex-between">
    <div class="small muted">
      Signed in as <b style="color:var(--text)"><%= user.display_name %></b> · @<%= user.username %>
    </div>
    <a class="btn btn-ghost btn-sm" href="/account/password">Change password</a>
  </div>
</div>

<%- include('../partials/footer') %>
