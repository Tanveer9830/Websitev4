<%- include('../partials/head', { title, active: 'owner' }) %>
<%- include('../partials/flash') %>

<div class="dash-head">
  <div>
    <h1>System health</h1>
    <p class="muted small mb0">Service status, database integrity and recent operational errors.</p>
  </div>
  <div class="dash-tabs" role="navigation" aria-label="Dashboards">
    <a href="/admin">Admin</a>
    <a href="/admin/owner" class="active">Owner</a>
  </div>
</div>

<div class="grid grid-4">
  <div class="card stat">
    <div class="num" style="font-size:22px"><span class="health-dot <%= integrity === 'ok' ? 'health-ok' : 'health-bad' %>"></span><%= integrity === 'ok' ? 'Healthy' : 'Check DB' %></div>
    <div class="lbl">SQLite integrity check</div>
  </div>
  <div class="card stat">
    <div class="num" style="font-size:22px"><%= pending %></div>
    <div class="lbl">Pending applications</div>
  </div>
  <div class="card stat">
    <div class="num" style="font-size:22px"><%= dbSize > 1048576 ? (dbSize / 1048576).toFixed(1) + ' MB' : (dbSize / 1024).toFixed(0) + ' KB' %></div>
    <div class="lbl">Database size</div>
  </div>
  <div class="card stat">
    <div class="num" style="font-size:22px"><%= Math.floor(uptime / 3600) %>h <%= Math.floor((uptime % 3600) / 60) %>m</div>
    <div class="lbl">Uptime</div>
  </div>
</div>

<div class="detail-grid mt">
  <div class="panel">
    <h2>Configuration</h2>
    <dl class="kv">
      <% for (const [k, v] of Object.entries(config)) { %>
        <dt><%= k %></dt>
        <dd class="mono small"><%= v %></dd>
      <% } %>
      <dt>Node.js</dt><dd class="mono small"><%= nodeVersion %></dd>
      <dt>Service version</dt><dd class="mono small">top-cloud 1.0.0</dd>
    </dl>
  </div>

  <div class="panel">
    <h2>Recent errors <span class="count">last <%= recentErrors.length %></span></h2>
    <% if (recentErrors.length === 0) { %>
      <p class="muted small mb0"><span class="health-dot health-ok"></span>No errors recorded since the last restart.</p>
    <% } else { %>
      <% for (const e of recentErrors.slice(0, 10)) { %>
        <div class="note-card" style="border-left-color:var(--err)">
          <div class="n-meta"><span class="mono"><%= e.ts %></span></div>
          <div class="mono small"><%= e.msg %></div>
        </div>
      <% } %>
    <% } %>
    <p class="faint small mt0">Full logs: <code class="inline">sudo journalctl -u top-cloud -f</code></p>
  </div>
</div>

<div class="panel mt">
  <h2>Latest applications</h2>
  <% if (recentApplications.length === 0) { %><p class="muted small mb0">None yet.</p><% } else { %>
    <div class="table-wrap" style="border:none;background:none">
      <table class="data" style="min-width:0">
        <thead><tr><th>Ref</th><th>Applicant</th><th>Position</th><th>Status</th><th>Submitted</th></tr></thead>
        <tbody>
          <% for (const a of recentApplications) { %>
            <tr>
              <td><span class="ref"><%= a.reference %></span></td>
              <td><%= a.applicant_name %></td>
              <td><%= a.position_title %></td>
              <td><span class="badge badge-<%= a.status %>"><%= statusLabels[a.status] %></span></td>
              <td class="muted small"><%= new Date(a.created_at).toLocaleString() %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
