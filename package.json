{
  "name": "top-cloud",
  "version": "1.0.0",
  "description": "TOP CLOUD — Staff Recruitment Portal. Made by Tanveer.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --import tsx --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "tsx watch src/index.ts",
    "migrate": "node --import tsx --disable-warning=ExperimentalWarning src/migrate.ts",
    "migrate:status": "node --import tsx --disable-warning=ExperimentalWarning src/migrate.ts --status",
    "bootstrap-owner": "node --import tsx --disable-warning=ExperimentalWarning src/bootstrap-owner.ts",
    "seed:demo": "node --import tsx --disable-warning=ExperimentalWarning src/seed-demo.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
