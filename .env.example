# TOP CLOUD — Staff Recruitment Portal
# Copy this file and fill in real values. On the production VPS the installer
# manages /etc/top-cloud/.env for you — do not commit real environment files.

# --- Core ---
# Where the app listens.
HOST=0.0.0.0
PORT=8080

# SQLite database location. Only `file:` (or a plain path) databases are
# supported by this deployment. The directory must exist and be writable
# by the user running the service.
DATABASE_URL=file:/var/lib/top-cloud/topcloud.db

# --- Security ---
# 32+ random bytes, base64. Generate with:
#   openssl rand -base64 48
# The installer generates this automatically on first run and preserves it
# on re-runs.
SESSION_SECRET=CHANGE_ME_random_64_chars_minimum

# Cookie Secure flag: auto = use TLS when the request is HTTPS.
SECURE_COOKIES=auto

# --- Owner bootstrap ---
# Username for the single Super Owner account created by
# `npm run bootstrap-owner` (the installer does this for you).
OWNER_USERNAME=owner

# --- Backups ---
# Directory for SQLite backups created from the owner dashboard.
BACKUP_DIR=/var/lib/top-cloud/backups

# --- Misc ---
# development | production
NODE_ENV=production
